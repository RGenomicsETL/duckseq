# fixture.gtf with Ensembl's attribute names (transcript_biotype, gene_biotype) and one
# extra lncRNA, tD, whose promoter window [10500, 12501) holds p17's centre. With the
# protein-coding filter tD drops out and the counts are fixture.gtf's; without it p17 is promoter.
chrF	fixture	gene	5001	9000	.	+	.	gene_id "gA"; gene_biotype "protein_coding";
chrF	fixture	transcript	5001	9000	.	+	.	gene_id "gA"; transcript_id "tA"; transcript_biotype "protein_coding";
chrF	fixture	exon	5001	5500	.	+	.	gene_id "gA"; transcript_id "tA"; exon_number 1;
chrF	fixture	exon	8501	9000	.	+	.	gene_id "gA"; transcript_id "tA"; exon_number 2;
chrF	fixture	CDS	5201	5500	.	+	0	gene_id "gA"; transcript_id "tA";
chrF	fixture	CDS	8501	8800	.	+	0	gene_id "gA"; transcript_id "tA";
chrF	fixture	UTR	5001	5200	.	+	.	gene_id "gA"; transcript_id "tA";
chrF	fixture	UTR	8801	9000	.	+	.	gene_id "gA"; transcript_id "tA";
