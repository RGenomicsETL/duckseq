# fixture.gtf plus a copy of tC on chrG under the same transcript_id and with no
# transcript line, as in GTFs that reuse ids across loci (seandavi/peakwhere#27). Each copy
# must keep its own chromosome and span: chrF counts stay fixture.gtf's, and peaks-chrG.bed's
# categories are in their names.
chrF	fixture	gene	5001	9000	.	+	.	gene_id "gA"; gene_type "protein_coding";
chrF	fixture	transcript	5001	9000	.	+	.	gene_id "gA"; transcript_id "tA"; transcript_type "protein_coding";
chrF	fixture	exon	5001	5500	.	+	.	gene_id "gA"; transcript_id "tA"; exon_number 1;
chrF	fixture	exon	8501	9000	.	+	.	gene_id "gA"; transcript_id "tA"; exon_number 2;
chrF	fixture	CDS	5201	5500	.	+	0	gene_id "gA"; transcript_id "tA";
chrF	fixture	CDS	8501	8800	.	+	0	gene_id "gA"; transcript_id "tA";
chrF	fixture	UTR	5001	5200	.	+	.	gene_id "gA"; transcript_id "tA";
chrF	fixture	UTR	8801	9000	.	+	.	gene_id "gA"; transcript_id "tA";
chrF	fixture	gene	15001	19000	.	-	.	gene_id "gB"; gene_type "protein_coding";
chrF	fixture	transcript	15001	19000	.	-	.	gene_id "gB"; transcript_id "tB"; transcript_type "protein_coding";
chrF	fixture	exon	18501	19000	.	-	.	gene_id "gB"; transcript_id "tB"; exon_number 1;
chrF	fixture	exon	15001	15500	.	-	.	gene_id "gB"; transcript_id "tB"; exon_number 2;
chrF	fixture	CDS	18501	18800	.	-	0	gene_id "gB"; transcript_id "tB";
chrF	fixture	CDS	15201	15500	.	-	0	gene_id "gB"; transcript_id "tB";
chrF	fixture	UTR	18801	19000	.	-	.	gene_id "gB"; transcript_id "tB";
chrF	fixture	UTR	15001	15200	.	-	.	gene_id "gB"; transcript_id "tB";
chrF	fixture	gene	23001	29000	.	+	.	gene_id "gC"; gene_type "protein_coding";
chrF	fixture	exon	23001	25000	.	+	.	gene_id "gC"; transcript_id "tC"; transcript_type "protein_coding"; exon_number 1;
chrF	fixture	exon	28001	29000	.	+	.	gene_id "gC"; transcript_id "tC"; transcript_type "protein_coding"; exon_number 2;
chrF	fixture	CDS	24501	25000	.	+	0	gene_id "gC"; transcript_id "tC";
chrF	fixture	CDS	28001	28500	.	+	0	gene_id "gC"; transcript_id "tC";
chrF	fixture	UTR	23001	24500	.	+	.	gene_id "gC"; transcript_id "tC";
chrF	fixture	UTR	28501	29000	.	+	.	gene_id "gC"; transcript_id "tC";
chrG	fixture	exon	3001	5000	.	+	.	gene_id "gC"; transcript_id "tC"; transcript_type "protein_coding"; exon_number 1;
chrG	fixture	exon	8001	9000	.	+	.	gene_id "gC"; transcript_id "tC"; transcript_type "protein_coding"; exon_number 2;
chrG	fixture	CDS	4501	5000	.	+	0	gene_id "gC"; transcript_id "tC";
chrG	fixture	CDS	8001	8500	.	+	0	gene_id "gC"; transcript_id "tC";
chrG	fixture	UTR	3001	4500	.	+	.	gene_id "gC"; transcript_id "tC";
chrG	fixture	UTR	8501	9000	.	+	.	gene_id "gC"; transcript_id "tC";
